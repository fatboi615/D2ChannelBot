/**
 *  @filename    ChannelBot.dbj
 *  @author      based on kolton/theBGuy structure
 *  @desc        Channel-sitting run tracker bot. Stays in channel at all times,
 *               never creates or joins games. Tracks runs announced by leader.
 *
 *  @typedef {import("./sdk/globals")}
 */

include("critical.js"); // required
includeSystemLibs();

// ============================================================================
// CONFIG
// ============================================================================
var CB_Channel            = "OP CHAOSBAAL";
var CB_LeaderAccount      = "name*account"; // charname*accountname
var CB_DataFilePath       = "data/ChannelBotStats.json";
var CB_AnnounceMilestone  = true;
var CB_MilestoneEvery     = 10;
var CB_GameAnnounceFormat = "** Next Game: {game} | Run #{runs} **";
var CB_MilestoneFormat    = "** {runs} total runs completed! **";
var CB_StartupMessage     = "** Run tracker online. Leader must !login to begin. **";
var CB_LogoutSuccess      = "** Leader logged out. Tracking paused. **";
var CB_GameAnnouncePrefix = "next game is"; // must be lowercase

// Periodic game list announce — posts recent games to channel every X ms
var CB_AnnounceGameList  = true;
var CB_GameListInterval  = 3 * 60 * 1000; // every 3 minutes
var CB_MaxGamesInList    = 5;

// Commands
var CB_CMD_LOGIN  = "!login";
var CB_CMD_LOGOUT = "!logout";
var CB_CMD_RUNS   = "!runs";
var CB_CMD_GAME   = "!game";
var CB_CMD_RESET  = "!reset";
var CB_CMD_HELP   = "!help";

// ============================================================================
// Tell Starter not to create or join games
// ============================================================================
Starter.Config.AnnounceGames = false;
Starter.Config.Games         = [];
Starter.Config.JoinChannel   = "";

if (typeof Starter.AdvancedConfig[me.profile] === "object") {
  Object.assign(Starter.Config, Starter.AdvancedConfig[me.profile]);
}
delete Starter.AdvancedConfig;

if (DataFile.init()) {
  Starter.firstRun = true;
}

// ============================================================================
// DATA HELPERS
// ============================================================================
function cbDefaultData() {
  return { totalRuns: 0, lastGame: { name: "", time: 0 }, recentGames: [] };
}

function cbReadData() {
  try {
    if (FileTools.exists(CB_DataFilePath)) {
      var raw = FileTools.readText(CB_DataFilePath);
      if (raw && raw.length > 0) {
        var parsed = JSON.parse(raw);
        // ensure recentGames exists on older data files
        if (!parsed.recentGames) parsed.recentGames = [];
        return parsed;
      }
    }
  } catch (e) {
    D2Bot.printToConsole("ChannelBot: read error - " + e, sdk.colors.D2Bot.Gray);
  }
  return cbDefaultData();
}

function cbWriteData(data) {
  try {
    FileTools.writeText(CB_DataFilePath, JSON.stringify(data, null, 2));
    return true;
  } catch (e) {
    D2Bot.printToConsole("ChannelBot: write error - " + e, sdk.colors.D2Bot.Gray);
    return false;
  }
}

function cbUpdateData(updateFn) {
  var data = cbReadData();
  updateFn(data);
  cbWriteData(data);
  return data;
}

function cbFormat(template, values) {
  return template.replace(/\{(\w+)\}/g, function (match, key) {
    return values.hasOwnProperty(key) ? values[key] : match;
  });
}

// ============================================================================
// SESSION STATE
// ============================================================================
var leaderLoggedIn  = false;
var lastTotalRuns   = -1;
var lastMilestone   = 0;
var lastGameListTick = 0;

// ============================================================================
// CHAT EVENT HANDLER
// ============================================================================
addEventListener("chatmsg", function (nick, msg) {
  var isLeader = nick.toLowerCase() === CB_LeaderAccount.toLowerCase();
  var raw = msg.trim();
  var m   = raw.toLowerCase();

  // PUBLIC commands — anyone
  if (m === CB_CMD_RUNS) {
    var d = cbReadData();
    say("Total runs completed: " + (d ? d.totalRuns : 0));
    return;
  }

  if (m === CB_CMD_GAME) {
    var d = cbReadData();
    if (d && d.lastGame && d.lastGame.name) {
      say("Last game: " + d.lastGame.name + " | Total runs: " + d.totalRuns);
    } else {
      say("No game info recorded yet.");
    }
    return;
  }

  // Silently ignore non-leaders beyond this point
  if (!isLeader) return;

  // !login — works before logged in
  if (m === CB_CMD_LOGIN) {
    if (leaderLoggedIn) {
      say("** Already logged in, " + nick + ". **");
    } else {
      leaderLoggedIn = true;
      D2Bot.printToConsole("ChannelBot: Leader logged in: " + nick, sdk.colors.D2Bot.Gray);
      var ld    = cbReadData();
      var lRuns = ld ? ld.totalRuns : 0;
      var lNext = (Math.floor(lRuns / CB_MilestoneEvery) + 1) * CB_MilestoneEvery;
      var lToGo = lNext - lRuns;
      say("** Welcome, " + nick + "! Runs completed: " + lRuns + " | Next milestone: run " + lNext + " (" + lToGo + " to go) **");
    }
    return;
  }

  // All remaining commands require active session
  if (!leaderLoggedIn) return;

  if (m === CB_CMD_LOGOUT) {
    leaderLoggedIn = false;
    D2Bot.printToConsole("ChannelBot: Leader logged out: " + nick, sdk.colors.D2Bot.Gray);
    say(CB_LogoutSuccess);
    return;
  }

  if (m === CB_CMD_HELP) {
    say("Public: " + CB_CMD_RUNS + " | " + CB_CMD_GAME +
        "  ||  Leader: " + CB_CMD_RESET + " | " + CB_CMD_LOGOUT);
    return;
  }

  if (m === CB_CMD_RESET) {
    cbWriteData(cbDefaultData());
    lastTotalRuns  = 0;
    lastMilestone  = 0;
    say("** Run stats have been reset. **");
    return;
  }

  // "Next game is <gamename>" — first word only, rest ignored
  if (m.indexOf(CB_GameAnnouncePrefix) === 0) {
    var remainder = raw.substring(CB_GameAnnouncePrefix.length).trim();

    if (!remainder) {
      say("** Couldn't parse game name. Format: Next game is <gamename> **");
      return;
    }

    var gameName = remainder.split(/\s+/)[0];

    var data = cbUpdateData(function (d) {
      d.totalRuns += 1;
      d.lastGame   = { name: gameName, time: getTickCount() };
      // keep a rolling list of recent games
      d.recentGames.unshift(gameName);
      if (d.recentGames.length > CB_MaxGamesInList) {
        d.recentGames = d.recentGames.slice(0, CB_MaxGamesInList);
      }
    });

    var runs = data ? data.totalRuns : "?";
    say(cbFormat(CB_GameAnnounceFormat, { game: gameName, runs: runs }));
    D2Bot.printToConsole("ChannelBot: Game announced: " + gameName + " run #" + runs, sdk.colors.D2Bot.Gray);

    // Milestone check
    if (CB_AnnounceMilestone) {
      var nextMilestone = (Math.floor((runs - 1) / CB_MilestoneEvery) + 1) * CB_MilestoneEvery;
      if (runs === nextMilestone && nextMilestone > lastMilestone) {
        say(cbFormat(CB_MilestoneFormat, { runs: runs }));
        lastMilestone = nextMilestone;
      }
    }

    lastTotalRuns = runs;
    return;
  }
});

// ============================================================================
// PERIODIC GAME LIST ANNOUNCE
// Call this from the main sit loop every tick
// ============================================================================
function cbCheckGameListAnnounce() {
  if (!CB_AnnounceGameList || !leaderLoggedIn) return;
  if (getTickCount() - lastGameListTick < CB_GameListInterval) return;

  var d = cbReadData();
  if (d && d.recentGames && d.recentGames.length > 0) {
    say("** Recent games: " + d.recentGames.join(", ") + " | Total runs: " + d.totalRuns + " **");
  }
  lastGameListTick = getTickCount();
}

// ============================================================================
// HELPER: join a channel using the Channel button + text box in lobby chat
// ============================================================================
function cbJoinChannel(channelName) {
  D2Bot.printToConsole("ChannelBot: Joining channel: " + channelName, sdk.colors.D2Bot.Gray);

  // Control.LobbyChannel = Button, 535, 490, 80, 20
  var channelBtn = getControl(sdk.controls.Button, 535, 490, 80, 20);
  if (!channelBtn) {
    D2Bot.printToConsole("ChannelBot: Could not find Channel button.", sdk.colors.D2Bot.Gray);
    return false;
  }
  channelBtn.click();
  delay(1000);

  // Control.LobbyChannelText = TextBox, 432, 162, 155, 20
  ControlAction.setText(sdk.controls.TextBox, 432, 162, 155, 20, channelName);
  delay(500);

  // Control.LobbyChannelOk = Button, 671, 433, 96, 32
  var okBtn = getControl(sdk.controls.Button, 671, 433, 96, 32);
  if (okBtn) okBtn.click();
  delay(1500);

  return true;
}

// ============================================================================
// LOCATION HANDLER
// ============================================================================
const locationAction = (function () {
  const { run } = require("./libs/oog/Locations");
  return {
    run: function (location) {
      switch (location) {

        case sdk.game.locations.Lobby:
          D2Bot.updateStatus("Lobby - clicking Enter Chat");
          D2Bot.printToConsole("ChannelBot: Lobby screen, clicking Enter Chat.", sdk.colors.D2Bot.Gray);
          delay(1000);
          // Control.LobbyEnterChat = Button, 27, 480, 120, 20
          var enterChat = getControl(sdk.controls.Button, 27, 480, 120, 20);
          if (enterChat) enterChat.click();
          delay(1000);
          break;

        case sdk.game.locations.LobbyChat:
          D2Bot.updateStatus("ChannelBot | " + CB_Channel + " | Runs: " + lastTotalRuns);
          cbJoinChannel(CB_Channel);
          delay(1000);
          say(CB_StartupMessage);
          lastGameListTick = getTickCount(); // reset timer so it doesn't fire immediately

          // Sit here — periodic announce runs in this loop
          while (getLocation() === sdk.game.locations.LobbyChat) {
            D2Bot.updateStatus("ChannelBot | " + CB_Channel + " | Runs: " + lastTotalRuns);
            cbCheckGameListAnnounce();
            delay(5000);
          }
          break;

        case sdk.game.locations.CreateGame:
        case sdk.game.locations.WaitingInLine:
          D2Bot.printToConsole("ChannelBot: Cancelling game creation.", sdk.colors.D2Bot.Gray);
          delay(500);
          // Control.CancelCreateGame = Button, 433, 433, 96, 32
          var cancelBtn = getControl(sdk.controls.Button, 433, 433, 96, 32);
          if (cancelBtn) cancelBtn.click();
          delay(500);
          break;

        case sdk.game.locations.JoinGame:
          D2Bot.printToConsole("ChannelBot: Cancelling join game.", sdk.colors.D2Bot.Gray);
          delay(500);
          // Control.CancelJoinGame = Button, 433, 433, 96, 32
          var cancelBtn = getControl(sdk.controls.Button, 433, 433, 96, 32);
          if (cancelBtn) cancelBtn.click();
          delay(500);
          break;

        default:
          run(location);
          break;
      }
    }
  };
})();

// ============================================================================
// MAIN
// ============================================================================
function main() {
  debugLog(me.profile);

  const Worker = require("./libs/modules/Worker");
  Worker.runInBackground.copyData = (function () {
    const workBench = [];
    addEventListener("copydata", function (mode, msg) {
      workBench.push({ mode: mode, msg: msg });
    });
    return function () {
      if (!workBench.length) return true;
      while (workBench.length) {
        const { mode, msg } = workBench.shift();
        Starter.receiveCopyData(mode, msg);
      }
      return true;
    };
  })();

  addEventListener("scriptmsg", Starter.scriptMsgEvent);

  while (!Starter.handle) {
    delay(100);
  }

  DataFile.updateStats("handle", Starter.handle);
  delay(500);
  D2Bot.init();
  load("threads/heartbeat.js");

  while (!Object.keys(Starter.gameInfo).length) {
    D2Bot.requestGameInfo();
    delay(500);
  }

  while (!Object.keys(Starter.profileInfo).length) {
    D2Bot.getProfile();
    delay(500);
  }

  var initData  = cbReadData();
  lastTotalRuns = initData.totalRuns;
  lastMilestone = Math.floor(initData.totalRuns / CB_MilestoneEvery) * CB_MilestoneEvery;
  D2Bot.printToConsole("ChannelBot: Initialized. Runs on record: " + lastTotalRuns, sdk.colors.D2Bot.Gray);

  while (true) {
    while (me.ingame) {
      delay(1000);
    }

    Starter.isUp = "no";
    locationAction.run(getLocation());
    delay(1000);
  }
}
