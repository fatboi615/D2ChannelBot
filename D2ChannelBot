include("critical.js");
includeSystemLibs();

// ============================================================================
// CONFIG
// ============================================================================
var CB_Channel            = "OP CHAOSBAAL";

var CB_Leaders            = [
  "CoopPoop*CooperCBRunz",
  // "AnotherChar*AnotherAccount",
];

var CB_LeaderProfileName  = "CBRUNZ";
var CB_LeaderDataFile     = "data/" + CB_LeaderProfileName + ".json";

var CB_DataFilePath       = "data/ChannelBotStats.json";
var CB_AnnounceMilestone  = true;
var CB_MilestoneEvery     = 50;
var CB_GameAnnounceFormat = "** Next Game: {game} | Run #{runs} **";
var CB_MilestoneFormat    = "** {runs} total runs completed! **";
var CB_StartupMessage     = "** Run tracker online. Authorized leaders can announce games anytime. **";
var CB_GameAnnouncePrefix = "next game is"; // must be lowercase

// Periodic recent games announce
var CB_AnnounceGameList  = true;
var CB_GameListInterval  = 3 * 60 * 1000;
var CB_MaxGamesInList    = 5;

// Commands
var CB_CMD_RUNS    = "!runs";
var CB_CMD_GAME    = "!game";
var CB_CMD_STATS   = "!stats";
var CB_CMD_RESET   = "!reset";
var CB_CMD_HELP    = "!help";

// ============================================================================
// Starter config
// ============================================================================
Starter.Config.AnnounceGames = false;
Starter.Config.Games         = [];
Starter.Config.JoinChannel   = "";

if (typeof Starter.AdvancedConfig[me.profile] === "object") {
  Object.assign(Starter.Config, Starter.AdvancedConfig[me.profile]);
}
delete Starter.AdvancedConfig;

if (DataFile.init()) {
  Starter.firstRun = true;
}

// ============================================================================
// DATA HELPERS
// ============================================================================
function cbDefaultData() {
  return {
    totalRuns:     0,
    lastGame:      { name: "", time: 0 },
    recentGames:   [],
    bestStreak:    0,
    currentStreak: 0,
    runTimes:      [],
    firstRunTime:  0,
  };
}

function cbReadData() {
  try {
    if (FileTools.exists(CB_DataFilePath)) {
      var raw = FileTools.readText(CB_DataFilePath);
      if (raw && raw.length > 0) {
        var parsed = JSON.parse(raw);
        var def = cbDefaultData();
        for (var key in def) {
          if (def.hasOwnProperty(key) && !parsed.hasOwnProperty(key)) {
            parsed[key] = def[key];
          }
        }
        return parsed;
      }
    }
  } catch (e) {
    D2Bot.printToConsole("ChannelBot: read error - " + e, sdk.colors.D2Bot.Gray);
  }
  return cbDefaultData();
}

function cbWriteData(data) {
  try {
    FileTools.writeText(CB_DataFilePath, JSON.stringify(data, null, 2));
    return true;
  } catch (e) {
    D2Bot.printToConsole("ChannelBot: write error - " + e, sdk.colors.D2Bot.Gray);
    return false;
  }
}

function cbUpdateData(updateFn) {
  var data = cbReadData();
  updateFn(data);
  cbWriteData(data);
  return data;
}

function cbFormat(template, values) {
  return template.replace(/\{(\w+)\}/g, function (match, key) {
    return values.hasOwnProperty(key) ? values[key] : match;
  });
}

// ============================================================================
// READ LEADER PROFILE RUN COUNT
// ============================================================================
function cbGetLeaderRuns() {
  try {
    if (FileTools.exists(CB_LeaderDataFile)) {
      var raw = FileTools.readText(CB_LeaderDataFile);
      if (raw && raw.length > 0) {
        var parsed = JSON.parse(raw);
        if (typeof parsed.runs !== "undefined") {
          return parseInt(parsed.runs, 10) || 0;
        }
      }
    }
  } catch (e) {
    D2Bot.printToConsole("ChannelBot: could not read leader profile - " + e, sdk.colors.D2Bot.Gray);
  }
  return -1;
}

// ============================================================================
// LEADER CHECK
// Checks nick against full "char*account", just charname, or just accountname
// Also logs the nick to console so we can verify the format
// ============================================================================
function cbIsLeader(nick) {
  if (!nick) return false;
  var n = nick.toLowerCase().trim();
  D2Bot.printToConsole("ChannelBot: chatmsg from: [" + n + "]", sdk.colors.D2Bot.Gray);
  for (var i = 0; i < CB_Leaders.length; i++) {
    var entry  = CB_Leaders[i].toLowerCase().trim();
    var parts  = entry.split("*");
    var cname  = parts[0] || "";
    var aname  = parts[1] || "";
    if (n === entry || n === cname || n === aname) {
      return true;
    }
  }
  return false;
}

// ============================================================================
// SESSION STATE
// ============================================================================
var lastTotalRuns    = -1;
var lastMilestone    = 0;
var lastGameListTick = 0;
var lastRunTick      = 0;
var sessionRunCount  = 0;
var sessionStartTick = getTickCount();

// ============================================================================
// CHAT EVENT HANDLER
// ============================================================================
addEventListener("chatmsg", function (nick, msg) {
  var isLeader = cbIsLeader(nick);
  var raw = msg.trim();
  var m   = raw.toLowerCase();

  // -----------------------------------------------------------------------
  // PUBLIC commands — anyone
  // -----------------------------------------------------------------------
  if (m === CB_CMD_RUNS) {
    var leaderRuns = cbGetLeaderRuns();
    var d          = cbReadData();
    var profileStr = leaderRuns >= 0 ? " | " + CB_LeaderProfileName + " profile runs: " + leaderRuns : "";
    say("** Tracked runs: " + (d ? d.totalRuns : 0) + profileStr + " **");
    return;
  }

  if (m === CB_CMD_GAME) {
    var d = cbReadData();
    if (d && d.lastGame && d.lastGame.name) {
      say("** Last game: " + d.lastGame.name + " | Total runs: " + d.totalRuns + " **");
    } else {
      say("** No game info recorded yet. **");
    }
    return;
  }

  if (m === CB_CMD_STATS) {
    var d          = cbReadData();
    var leaderRuns = cbGetLeaderRuns();
    if (!d || d.totalRuns === 0) {
      say("** No stats recorded yet. **");
      return;
    }
    var avgStr = "N/A";
    if (d.runTimes && d.runTimes.length > 0) {
      var total = 0;
      for (var i = 0; i < d.runTimes.length; i++) total += d.runTimes[i];
      var avgMs  = Math.floor(total / d.runTimes.length);
      var avgMin = Math.floor(avgMs / 60000);
      var avgSec = Math.floor((avgMs % 60000) / 1000);
      avgStr = avgMin + "m " + avgSec + "s";
    }
    var nextMs     = (Math.floor(d.totalRuns / CB_MilestoneEvery) + 1) * CB_MilestoneEvery;
    var toGo       = nextMs - d.totalRuns;
    var sessElapsed = Math.floor((getTickCount() - sessionStartTick) / 60000);
    var profileStr = leaderRuns >= 0 ? " | " + CB_LeaderProfileName + " total: " + leaderRuns : "";
    say("** Stats: Tracked runs: " + d.totalRuns
      + profileStr
      + " | Best streak: " + (d.bestStreak || 0)
      + " | Avg run time: " + avgStr
      + " | Next milestone: " + nextMs + " (" + toGo + " to go)"
      + " | Session: " + sessionRunCount + " runs in " + sessElapsed + " min **");
    return;
  }

  if (m === CB_CMD_HELP) {
    say("** Commands: "
      + CB_CMD_RUNS + " | "
      + CB_CMD_GAME + " | "
      + CB_CMD_STATS
      + " || Leaders only: "
      + CB_CMD_RESET
      + " **");
    return;
  }

  // -----------------------------------------------------------------------
  // Beyond here: silently ignore non-leaders
  // -----------------------------------------------------------------------
  if (!isLeader) return;

  if (m === CB_CMD_RESET) {
    cbWriteData(cbDefaultData());
    lastTotalRuns   = 0;
    lastMilestone   = 0;
    sessionRunCount = 0;
    say("** Run stats have been reset. **");
    return;
  }

  // "Next game is <gamename>"
  if (m.indexOf(CB_GameAnnouncePrefix) === 0) {
    var remainder = raw.substring(CB_GameAnnouncePrefix.length).trim();
    if (!remainder) {
      say("** Format: Next game is <gamename> **");
      return;
    }

    var gameName  = remainder.split(/\s+/)[0];
    var nowTick   = getTickCount();
    var runTimeMs = (lastRunTick > 0) ? (nowTick - lastRunTick) : 0;
    lastRunTick   = nowTick;
    sessionRunCount += 1;

    var data = cbUpdateData(function (d) {
      d.totalRuns += 1;
      d.lastGame   = { name: gameName, time: nowTick };
      d.recentGames.unshift(gameName);
      if (d.recentGames.length > CB_MaxGamesInList) {
        d.recentGames = d.recentGames.slice(0, CB_MaxGamesInList);
      }
      if (runTimeMs > 0 && runTimeMs < 30 * 60 * 1000) {
        d.runTimes.push(runTimeMs);
        if (d.runTimes.length > 100) d.runTimes = d.runTimes.slice(-100);
      }
      d.currentStreak = (d.currentStreak || 0) + 1;
      if (d.currentStreak > (d.bestStreak || 0)) d.bestStreak = d.currentStreak;
      if (d.firstRunTime === 0) d.firstRunTime = nowTick;
    });

    // Use leader profile run count for display if available
    var leaderRuns  = cbGetLeaderRuns();
    var displayRuns = leaderRuns >= 0 ? leaderRuns : (data ? data.totalRuns : "?");

    say(cbFormat(CB_GameAnnounceFormat, { game: gameName, runs: displayRuns }));
    D2Bot.printToConsole("ChannelBot: Game announced: " + gameName + " run #" + displayRuns, sdk.colors.D2Bot.Gray);

    if (CB_AnnounceMilestone) {
      var trackedRuns   = data ? data.totalRuns : 0;
      var nextMilestone = (Math.floor((trackedRuns - 1) / CB_MilestoneEvery) + 1) * CB_MilestoneEvery;
      if (trackedRuns === nextMilestone && nextMilestone > lastMilestone) {
        say(cbFormat(CB_MilestoneFormat, { runs: trackedRuns }));
        lastMilestone = nextMilestone;
      }
    }

    lastTotalRuns = data ? data.totalRuns : lastTotalRuns;
    return;
  }
});

// ============================================================================
// PERIODIC GAME LIST ANNOUNCE
// ============================================================================
function cbCheckGameListAnnounce() {
  if (!CB_AnnounceGameList) return;
  if (getTickCount() - lastGameListTick < CB_GameListInterval) return;

  var d          = cbReadData();
  var leaderRuns = cbGetLeaderRuns();
  var runsStr    = leaderRuns >= 0 ? leaderRuns : (d ? d.totalRuns : 0);

  if (d && d.recentGames && d.recentGames.length > 0) {
    say("** Recent games: " + d.recentGames.join(", ") + " | Total runs: " + runsStr + " **");
  }
  lastGameListTick = getTickCount();
}

// ============================================================================
// CHANNEL JOIN HELPER
// ============================================================================
function cbJoinChannel(channelName) {
  D2Bot.printToConsole("ChannelBot: Joining channel: " + channelName, sdk.colors.D2Bot.Gray);
  var channelBtn = getControl(sdk.controls.Button, 535, 490, 80, 20);
  if (channelBtn) {
    channelBtn.click();
    delay(1000);
  }
  ControlAction.setText(sdk.controls.TextBox, 432, 162, 155, 20, channelName);
  delay(500);
  var okBtn = getControl(sdk.controls.Button, 671, 433, 96, 32);
  if (okBtn) okBtn.click();
  delay(1500);
}

// ============================================================================
// LOCATION HANDLER
// ============================================================================
const locationAction = (function () {
  const { run } = require("./libs/oog/Locations");
  return {
    run: function (location) {
      switch (location) {
        case sdk.game.locations.Lobby:
          D2Bot.updateStatus("Lobby - clicking Enter Chat");
          delay(1000);
          var enterChat = getControl(sdk.controls.Button, 27, 480, 120, 20);
          if (enterChat) enterChat.click();
          delay(1000);
          break;

        case sdk.game.locations.LobbyChat:
          D2Bot.updateStatus("ChannelBot | " + CB_Channel + " | Runs: " + lastTotalRuns);
          cbJoinChannel(CB_Channel);
          delay(1000);
          say(CB_StartupMessage);
          lastGameListTick = getTickCount();

          while (getLocation() === sdk.game.locations.LobbyChat) {
            D2Bot.updateStatus("ChannelBot | " + CB_Channel + " | Runs: " + lastTotalRuns);
            cbCheckGameListAnnounce();
            delay(5000);
          }
          break;

        case sdk.game.locations.CreateGame:
        case sdk.game.locations.WaitingInLine:
        case sdk.game.locations.JoinGame:
          D2Bot.printToConsole("ChannelBot: Cancelling game action.", sdk.colors.D2Bot.Gray);
          delay(500);
          var cancelBtn = getControl(sdk.controls.Button, 433, 433, 96, 32);
          if (cancelBtn) cancelBtn.click();
          delay(500);
          break;

        default:
          run(location);
          break;
      }
    }
  };
})();

// ============================================================================
// MAIN
// ============================================================================
function main() {
  debugLog(me.profile);

  const Worker = require("./libs/modules/Worker");
  Worker.runInBackground.copyData = (function () {
    const workBench = [];
    addEventListener("copydata", function (mode, msg) {
      workBench.push({ mode: mode, msg: msg });
    });
    return function () {
      if (!workBench.length) return true;
      while (workBench.length) {
        const item = workBench.shift();
        Starter.receiveCopyData(item.mode, item.msg);
      }
      return true;
    };
  })();

  addEventListener("scriptmsg", Starter.scriptMsgEvent);

  while (!Starter.handle) delay(100);

  DataFile.updateStats("handle", Starter.handle);
  delay(500);
  D2Bot.init();
  load("threads/heartbeat.js");

  while (!Object.keys(Starter.gameInfo).length) {
    D2Bot.requestGameInfo();
    delay(500);
  }

  while (!Object.keys(Starter.profileInfo).length) {
    D2Bot.getProfile();
    delay(500);
  }

  var initData  = cbReadData();
  lastTotalRuns = initData.totalRuns;
  lastMilestone = Math.floor(initData.totalRuns / CB_MilestoneEvery) * CB_MilestoneEvery;
  D2Bot.printToConsole("ChannelBot initialized. Tracked runs: " + lastTotalRuns, sdk.colors.D2Bot.Gray);

  while (true) {
    while (me.ingame) delay(1000);
    Starter.isUp = "no";
    locationAction.run(getLocation());
    delay(1000);
  }
}
